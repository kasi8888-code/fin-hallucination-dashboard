.cache/
~/.cache/huggingface/
*.safetensors
transformers_cache/
hf_cache/

# =============================================================
# Data Files
# (Raw CSVs and processed feature matrices can be large)
# =============================================================
data/processed_features_benchmark.csv

# Keep the curated benchmark dataset (source of truth)
!data/financial_qa_dataset.json

